{
  "name": "test",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "NODE_USE_SYSTEM_CA=1 ng serve",
    "start:all": "NODE_USE_SYSTEM_CA=1 ng build -c dev-all && (NODE_USE_SYSTEM_CA=1 ng build -c dev-all --watch & NODE_USE_SYSTEM_CA=1 PORT=4200 node --watch dist/test/server/server.mjs)",
    "start:en": "NODE_USE_SYSTEM_CA=1 ng serve --configuration development-en",
    "start:dev": "NODE_USE_SYSTEM_CA=1 ng serve --configuration development-en & NODE_USE_SYSTEM_CA=1 ng serve --configuration development",
    "build": "NODE_USE_SYSTEM_CA=1 ng build",
    "watch": "NODE_USE_SYSTEM_CA=1 ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed --project=chromium",
    "lint": "eslint src",
    "serve:ssr:test": "NODE_USE_SYSTEM_CA=1 node dist/test/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/aria": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.6",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.1"
  }
}
